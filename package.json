{
  "name": "tdd-token-experiment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch replication of the Thoughtworks TDD-in-the-agent-loop token experiment, with the token bill counted two different ways.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "reference": "node harness/run.mjs --tasks small,medium,large --arms reference",
    "experiment": "caffeinate -i node harness/run.mjs --tasks small,medium,large --arms tdd,spec-first,no-tests --repeats 2 --timeout-min 30 --max-budget-usd 4 --retries 1",
    "experiment:linux": "systemd-inhibit --what=idle node harness/run.mjs --tasks small,medium,large --arms tdd,spec-first,no-tests --repeats 2 --timeout-min 30 --max-budget-usd 4 --retries 1",
    "report": "node harness/report.mjs",
    "serve": "node app/server.mjs",
    "verify": "node harness/verify-holdout.mjs"
  }
}
